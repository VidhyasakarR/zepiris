{
  "name": "@loadshare/rn-lsn-capture",
  "version": "1.0.0",
  "description": "Android-only React Native SDK for the Zepiris LSN checkpoint selfie: native capture screen with liveness, and /v1/checkpoint/score",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "private": true,
  "files": [
    "src",
    "lib",
    "android",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/build",
    "!android/.gradle",
    "!android/.idea",
    "!android/local.properties"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "prepare": "bob build",
    "pack:dist": "bob build && npm pack --pack-destination ../dist"
  },
  "keywords": [
    "react-native",
    "android",
    "selfie",
    "liveness",
    "face-match",
    "zepiris"
  ],
  "author": "Loadshare",
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.77.3",
    "react-native-builder-bob": "^0.23.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
